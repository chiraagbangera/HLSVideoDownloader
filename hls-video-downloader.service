[Unit]
Description=HLS Video Downloader
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/Videos

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/hls-video-downloader

Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/tmp/hls-video-downloader/home
Environment=TMPDIR=/var/tmp/hls-video-downloader/tmp
Environment=DOWNLOAD_DIR=/mnt/Videos
Environment=TEMP_DOWNLOAD_DIR=/var/tmp/hls-video-downloader/jobs
Environment=FFMPEG_BIN=/usr/bin/ffmpeg
Environment=FFPROBE_BIN=/usr/bin/ffprobe
Environment=MAX_CONCURRENT_DOWNLOADS=2
Environment=COMPLETED_JOB_TTL_HOURS=24
ExecStart=/opt/hls-video-downloader/.venv/bin/gunicorn --workers 1 --threads 8 --bind 0.0.0.0:99 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Port 99 is privileged on Linux.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Avoid systemd mount-namespace restrictions here. Some Raspberry Pi OS
# configurations cannot create the required namespace and fail with
# status=226/NAMESPACE before Gunicorn starts.

[Install]
WantedBy=multi-user.target
